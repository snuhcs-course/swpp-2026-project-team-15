# Copy to server/.env (gitignored). Keys stay on the server, never in the Android app or Git.
# mock: replay recorded responses from fixtures/vision (no network, no API cost).
# gemini: call the Gemini API (requires GEMINI_API_KEY and GEMINI_MODEL).
VISION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
# e.g. gemini-3.5-flash-lite (verified 2026-10-11; Gemini 1.5 models are no longer listed)
# Relative to the repository root; built by server/db/import_recipes.py.
RECIPE_DB_PATH=data/recipes/recipes.sqlite3

# Recipe Revision
# mock (default) makes no network calls. live requires the three settings below.
REVISION_PROVIDER=mock
REVISION_LLM_ENDPOINT=https://api.example.com/v1/chat/completions
REVISION_LLM_MODEL=your-structured-output-model
# Leave empty for Mock runs. Set your own key only in .env or the environment.
REVISION_LLM_API_KEY=