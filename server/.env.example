# Copy to server/.env (gitignored). Keys stay on the server, never in the Android app or Git.
# mock: replay recorded responses from fixtures/vision (no network, no API cost).
# gemini: call the Gemini API (requires GEMINI_API_KEY and GEMINI_MODEL).
VISION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
# Relative to the repository root; built by server/db/import_recipes.py.
RECIPE_DB_PATH=data/recipes/recipes.sqlite3
