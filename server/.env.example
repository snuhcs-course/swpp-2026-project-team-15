# Copy to server/.env (gitignored). Keys stay on the server, never in the Android app or Git.
# mock: replay recorded responses from fixtures/vision (no network, no API cost).
# gemini: call the Gemini API (requires GEMINI_API_KEY and GEMINI_MODEL).
# openrouter: requires OPENROUTER_API_KEY and OPENROUTER_VISION_MODEL.
VISION_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=

# Dish suggestions. The model key defaults to OPENROUTER_API_KEY; without any key the rules-only
# ranking is used.
DISH_LLM_MODEL=google/gemini-2.5-flash-lite
# Cache filled by `python -m app.dishes.prefetch` (deploy/dish-cache.sh on the server); without it
# videos are empty and only a search link is sent. The file is re-read when it changes.
DISH_VIDEO_CACHE=
