# Copy this file to .env. PIXABAY_KEY can also be set in the process environment.
PIXABAY_KEY=

# Paths are absolute or relative to the tools/ directory.
PIXABAY_RECIPES_FILE=crawlers/pixabay/recipes.json
PIXABAY_CACHE_DIR=crawlers/pixabay/cache
PIXABAY_SHEETS_DIR=crawlers/pixabay/sheets
PIXABAY_SELECTIONS_DIR=crawlers/pixabay/selections
PIXABAY_DOWNLOADS_DIR=crawlers/pixabay/downloads
PIXABAY_IMAGES_DIR=../server/recipe_images/images
PIXABAY_OUTPUT_DIR=crawlers/pixabay/output
PIXABAY_MAPPING_FILE=crawlers/pixabay/output/recipe_image_urls.csv
PIXABAY_SOURCE_RECIPE_CSV=../data/recipes/Recipe.csv
PIXABAY_OUTPUT_RECIPE_CSV=crawlers/pixabay/output/Recipe.csv
PIXABAY_IMAGE_URL_PREFIX=/recipe-images
PIXABAY_IMAGE_VARIANT=list
