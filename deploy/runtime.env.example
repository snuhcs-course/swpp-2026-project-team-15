# Copy to deploy/runtime.env (gitignored, chmod 600) and fill in the keys. Keys stay on the server,
# never in Git, images or the app.
VISION_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_VISION_MODEL=google/gemini-2.5-flash-lite
# Dish suggestions use OPENROUTER_API_KEY too; override the model if needed:
# DISH_LLM_MODEL=google/gemini-2.5-flash-lite
# Video links: YouTube Data API v3 key (videos.list only; about 1 quota unit per dish).
YOUTUBE_API_KEY=
