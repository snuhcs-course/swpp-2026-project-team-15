  "thresholds": {
    "valid_names_share": {
      "min": 1.0,
      "unit": "returned dish names that are in the dish-name list, over all model answers"
    },
    "have_subset_share": {
      "min": 0.95,
      "unit": "returned dishes whose every 'have' item is one of the user's ingredients (trim, spaces removed, exact or synonym)"
    },
    "missing_disjoint_share": {
      "min": 0.95,
      "unit": "returned dishes with no 'missing' item among the user's ingredients (same matching)"
    },
    "nonempty_when_possible": {
      "min": 0.9,
      "unit": "cases whose reference set is not empty and where at least one dish is returned"
    },
    "reference_recall": {
      "min": 0.6,
      "unit": "reference dishes returned, pooled over cases"
    },
    "reference_precision": {
      "min": 0.6,
      "unit": "returned dishes in the reference set, pooled over cases (lower bound)"
    },
    "reference_le2_missing_share": {
      "min": 0.8,
      "unit": "returned dishes with at most two missing key ingredients by the reference calculation"
    },
    "malformed_refused": {
      "min": 1.0,
      "unit": "cases S27 and S31 refused with 422"
    },
    "model_failure_is_502": {
      "min": 1.0,
      "unit": "checked offline with a failing transport (unit tests)"
    },
    "median_latency_s": {
      "max": 5.0
    }
  },
  "report_only": [
    "have_subset_share_with_staples_allowed",
    "empty_when_reference_empty",
    "input_tokens",
    "output_tokens",
    "reasoning_tokens",
    "cost_usd",
    "hybrid_reference_recall_precision (stored hybrid answers, same inputs)",
    "truncated_answers"
  ],
  "limits": [
    "single run, temperature 0",
    "31 inputs: one case moves a share by about 3 points",
    "one model",
    "reference is rule-made, not human-labelled, and shares the dish list with the system"
  ],
  "max_model_calls": 80
}
